            "questionId": 35,
            "answerId": 35,
            "evaluationId": 35,
            "evidence": [
              {
                "chunkId": 18,
                "documentTitle": "Java 핵심 동작과 경계 · initial-v1",
                "documentVersion": 1,
                "startOffset": 306,
                "endOffset": 558,
                "content": "[JAVA-102]\n메서드 호출에는 어떤 선언이 적용 가능한지 고르는 단계와 실행할 인스턴스 구현을 찾는 단계가 있다. 인수의 정적 타입은 오버로드 해석에 참여한다. 런타임의 동적 디스패치는 오버라이딩된 인스턴스 구현에 관한 것이며, 인수의 실제 객체를 보고 모든 오버로드 후보를 다시 비교하는 방식이 아니다.\n근거: JAVA-EXPR — 15.12.2 Compile-Time Step 2; 15.12.4.4 Locate Method to Invoke"
              }
