  "policy": {
    "name": "trusted-query-supported-evidence-v1",
    "candidateScope": "same Topic, PUBLISHED documents, not EMBEDDING_FAILED",
    "trustedQuery": "question + referenceAnswer; submitted answer excluded from retrieval scoring",
    "eligibility": "concept token match OR at least 2 distinct trusted query token matches",
    "score": "3 * concept token matches + trusted query token matches; case-insensitive substring match",
    "relativeCutoff": 0.5,
    "conceptReservation": "highest-ranked chunk per nonempty full concept-name token set with at least 2 additional query token matches",
    "conflictReservation": "if initial selection has no conflict, reserve strongest candidate with 2 additional query token matches, >=0.5 exact candidate token query coverage, and existing shared-token/negation conflict relation to initial selection",
    "selection": "reserve global top and protected IDs in rank order up to K, fill from >=0.5*top, return score/documentId/sequenceNo order",
    "capacityBoundary": "protected candidates exceeding K still limited by rank; complete concept/conflict coverage not guaranteed"
  },
  "documents": 60,
  "referenceEvidenceSpans": 120,
  "persistedChunks": 60,
  "chunkPolicies": [
    "paragraph-1000-overlap-150-v1"
  ],
  "conceptInput": "questions.jsonl concepts.name (same field as production)",
  "aiCalls": 0,
  "independentBenchmark": false,
  "irrelevancePolicy": "not in mapped reference IDs; cross-question relevance not independently annotated",
  "limitations": [
    "60 reference documents become 60 chunks; each question has one distinct relevant DB chunk after mapping.",
    "180 answer cases are 60 distinct question/reference retrieval inputs because submitted answers no longer affect retrieval.",
    "Reference answers closely overlap the evidence summaries; the high score is not independent generalization evidence.",
    "Development 138 and public evaluation-candidate 42 queries were measured repeatedly; not an untouched holdout. Additional fixes used separate synthetic regression fixtures.",
    "Keyword substring matching and negation heuristics can still miss synonyms or mistake short unrelated negative statements for conflicts.",
    "No external evaluation model, API-to-worker quality experiment, operational migration, or production load validation."
  ],
